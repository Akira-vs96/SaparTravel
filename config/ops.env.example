# Copy outside the repository with permissions 0600. Never commit actual secrets.
# Each of the three independent monitoring hosts receives ONLY its own probe credentials.
SLI_CONFIG=/etc/sapartravel/point-a.json
SLI_LOG=/var/lib/sapartravel/monitoring/point-a.jsonl
SLI_EMAIL=
SLI_PASSWORD=
OPS_LOCK_DIRECTORY=/var/lib/sapartravel/locks
# Database jobs run on the backup host, not on public monitoring nodes.
BACKUP_DATABASE_URL=
RESTORE_ADMIN_DATABASE_URL=
BACKUP_DIRECTORY=/var/lib/sapartravel/backups
# Mount an independently protected storage destination; distinct path alone does not prove off-site storage.
BACKUP_COPY_DIRECTORY=/mnt/sapartravel-backups
OPS_REPORT_DIRECTORY=/var/lib/sapartravel/reports
PG_BIN_DIRECTORY=/usr/lib/postgresql/17/bin
MONTHLY_INPUT_DIRECTORY=/var/lib/sapartravel/monthly-input
