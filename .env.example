# Generate local secrets with: python3 scripts/setup_env.py
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_DEMO_DATA=true
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
# Public API address embedded at frontend build time; same origin by default.
VITE_API_URL=/api/v1
# For a backend running outside Docker; use the same PostgreSQL password.
# DATABASE_URL=postgresql+psycopg://sapar:YOUR_PASSWORD@localhost:5432/sapartravel
